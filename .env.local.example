# ---------- Database ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quest-board?retryWrites=true&w=majority

# ---------- Auth.js (NextAuth) ----------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string   # generate with: openssl rand -base64 32

# ---------- Professor gate ----------
# Whoever knows this exact string can register as a Professor at /login.
# Keep it out of anything you hand in or push publicly — share it verbally/
# privately with whoever should have Professor access for grading/demo.
PROFESSOR_SECRET_CODE=choose-a-secret-code-here

# ---------- AI providers ----------
# For now, every AI route (syllabus conversion, sidekick, pre-grading) runs on
# this single Gemini key — see app/api/ai/*/route.js.
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# Once you've funded an Anthropic account, uncomment this and flip the
# commented-out `anthropic(...)` lines back on in sidekick/route.js and
# pre-grade/route.js to move the mentor + pre-grading pipelines to Claude.
# ANTHROPIC_API_KEY=your-anthropic-api-key
